# Set exactly one of USE_OPEN_ROUTER, USE_BEDROCK, or USE_VERTEX_AI to true
USE_OPEN_ROUTER=false
USE_BEDROCK=false
USE_VERTEX_AI=false

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
RESEND_API_KEY=
RESEND_FROM="Sentinel <onboarding@resend.dev>"
SENDGRID_API_KEY=
SENDGRID_FROM="Sentinel <onboarding@resend.dev>"
SENDGRID_SENDER_EMAIL=
PUSHOVER_TOKEN=
PUSHOVER_USER_KEY=
PUSHOVER_USER=
REMINDER_INTERVAL_SECONDS=60
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Backend JWT verification (use one). Issuer must match the `iss` claim on Clerk session tokens (no trailing slash).
# CLERK_ISSUER=https://YOUR-INSTANCE.clerk.accounts.dev
CLERK_JWKS_URL=
# For Clerk local testing: set CLERK_ISSUER or CLERK_JWKS_URL and do NOT set AUTH_DISABLED=true.
# For no-Clerk local dev: omit both Clerk vars (run_local.py sets AUTH_DISABLED) or set AUTH_DISABLED=true.
S3_BUCKET=
OPENAI_API_KEY=
DEFAULT_AWS_REGION=
AWS_ACCOUNT_ID=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=
BEDROCK_REGION=

# GCP / Vertex AI
GCP_PROJECT_ID=
GOOGLE_CLOUD_PROJECT=
GCP_REGION=us-central1
GCP_LOCATION=us-central1
VERTEX_AI_MODEL=gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
GEMINI_API_KEY=
PUBSUB_JOBS_TOPIC=

# Aurora Data API (required for backend persistence)
AURORA_CLUSTER_ARN=
AURORA_SECRET_ARN=
AURORA_DATABASE=sentinel
LOCAL_DB_PATH=./sentinel.db

# GCP Cloud SQL PostgreSQL
GCP_CLOUDSQL_CONNECTION_NAME=
GCP_DB_NAME=sentinel
GCP_DB_USER=sentinel
GCP_DB_PASSWORD=
GCP_DB_HOST=127.0.0.1
GCP_DB_PORT=5432

# Comma-separated: which severities trigger Settings integrations (Slack / webhooks / PagerDuty).
# For demos, you can use: medium,high,critical
INTEGRATION_NOTIFY_SEVERITIES=medium,high,critical

# Optional link appended to Slack / generic webhook payloads (no trailing slash).
# SENTINEL_PUBLIC_URL=https://your-cloudfront-domain
